PORT=3000
NODE_ENV=development
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated exact origins. For production, add chrome-extension://YOUR_EXTENSION_ID
ALLOWED_ORIGINS=
# Set true only after configuring Supabase and implementing sign-in in the extension.
AUTH_REQUIRED=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
