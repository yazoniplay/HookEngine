{
  "manifest_version": 3,
  "name": "HookEngine — Content Repurposer",
  "version": "1.4.0",
  "description": "Turn articles and public YouTube videos into ready-to-edit social content.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtu.be/*",
    "https://ppaknwuwiublxogclqdw.supabase.co/*"
  ],
  "action": {
    "default_title": "Open HookEngine"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
